    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- =====================================================
         🌐 전체 앱 래퍼 (UI 안정화용)
         ===================================================== -->
    <div class="app-wrapper">

      <!-- ===================================================
           📦 실제 페이지 콘텐츠 삽입 영역
